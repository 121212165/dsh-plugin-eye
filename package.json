{
  "name": "dsh-plugin-eye",
  "version": "0.1.0",
  "description": "dsh plugin: 电脑的眼睛——活动窗口/前台应用清单 + 全屏截图到 ~/.dsh/eye/captures 供 agent 查看屏幕；摄像头 capture 留二期接口，默认禁用。",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*": "./locale/*",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "screen",
    "screenshot",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/121212165/dsh-plugin-eye.git"
  },
  "sideEffects": false,
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-base": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "icon": "./icon.svg"
}
